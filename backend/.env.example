# Copia este archivo a .env (cp .env.example .env). El .env no se sube a Git.
# Los valores por defecto coinciden con docker-compose.yml.

PORT=3000
# Origen del frontend en desarrollo (Vite). Solo hace falta si no se usa su proxy.
CORS_ORIGIN=http://localhost:5173

# Si cambiaste POSTGRES_PORT en el compose, cambia también el puerto aquí.
DATABASE_URL=postgres://plomada:plomada@localhost:5432/plomada
DATABASE_URL_TEST=postgres://plomada:plomada@localhost:5432/plomada_test

# Autenticación. Cambia los secretos; en el repo solo viven estos valores de ejemplo.
JWT_ACCESS_SECRET=cambia-este-secreto-en-tu-maquina
# Duraciones de referencia (ver TOKENS en @plomada/shared): 15 min y 7 días.
JWT_ACCESS_TTL_MINUTOS=15
REFRESH_TTL_DIAS=7

# Fotos de evidencia en disco local, detrás del puerto de almacenamiento.
FOTOS_DIR=./data/fotos

# Mailpit (SMTP de pruebas del docker-compose). Interfaz en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
CORREO_REMITENTE=programacion@plomada.local
