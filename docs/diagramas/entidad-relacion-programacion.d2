...@estilo
direction: down

# Tablas del módulo programacion. usuarios es de identidad y solo se muestra
# como destino de la clave foránea de las asignaciones.

usuarios: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
}

centros_trabajo: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  nombre: "VARCHAR(255)"
  direccion: "TEXT"
  creado_en: "TIMESTAMPTZ"
}

programaciones_semanales: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  semana_inicio: "DATE [UK]"
  estado: "VARCHAR(50)"
  publicada_en: "TIMESTAMPTZ"
  creado_en: "TIMESTAMPTZ"
}

asignaciones: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  programacion_id: "UUID [FK]"
  operario_id: "UUID [FK]"
  centro_trabajo_id: "UUID [FK]"
  fecha: "DATE"
  creado_en: "TIMESTAMPTZ"
}

actividades: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  asignacion_id: "UUID [FK]"
  descripcion: "TEXT"
  creado_en: "TIMESTAMPTZ"
}

usuarios -> asignaciones: "1:N" {style.font-size: 24}
centros_trabajo -> asignaciones: "1:N" {style.font-size: 24}
programaciones_semanales -> asignaciones: "1:N" {style.font-size: 24}
asignaciones -> actividades: "1:N" {style.font-size: 24}
