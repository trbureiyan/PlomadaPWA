...@estilo
direction: right

usuarios: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  nombre: "VARCHAR(255)"
  correo: "VARCHAR(255) [UK]"
  rol: "VARCHAR(50)"
  contrasena_hash: "VARCHAR(255)"
  creado_en: "TIMESTAMPTZ"
}

sesiones: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  usuario_id: "UUID [FK]"
  token_refresco_hash: "VARCHAR(255)"
  expira_en: "TIMESTAMPTZ"
  revocado_en: "TIMESTAMPTZ"
  creado_en: "TIMESTAMPTZ"
}

hojas_de_vida: {
  shape: sql_table
  style.font-size: 28
  operario_id: "UUID [PK, FK]"
  nombre_completo: "VARCHAR(255)"
  tipo_documento: "VARCHAR(10)"
  numero_documento: "VARCHAR(50)"
  telefono: "VARCHAR(50)"
  cargo: "VARCHAR(100)"
  fecha_ingreso: "DATE"
  formacion: "JSONB"
  experiencia: "JSONB"
  curso_alturas: "BOOLEAN"
  vencimiento_alturas: "DATE"
  actualizado_en: "TIMESTAMPTZ"
}

centros_trabajo: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  nombre: "VARCHAR(255)"
  direccion: "TEXT"
  creado_en: "TIMESTAMPTZ"
}

programaciones_semanales: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  semana_inicio: "DATE [UK]"
  estado: "VARCHAR(50)"
  publicada_en: "TIMESTAMPTZ"
  creado_en: "TIMESTAMPTZ"
}

asignaciones: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  programacion_id: "UUID [FK]"
  operario_id: "UUID [FK]"
  centro_trabajo_id: "UUID [FK]"
  fecha: "DATE"
  creado_en: "TIMESTAMPTZ"
}

actividades: {
  shape: sql_table
  style.font-size: 28
  id: "UUID [PK]"
  asignacion_id: "UUID [FK]"
  descripcion: "TEXT"
  creado_en: "TIMESTAMPTZ"
}

usuarios -> sesiones: "1:N" {style.font-size: 24}
usuarios -> hojas_de_vida: "1:1" {style.font-size: 24}
usuarios -> asignaciones: "1:N" {style.font-size: 24}
centros_trabajo -> asignaciones: "1:N" {style.font-size: 24}
programaciones_semanales -> asignaciones: "1:N" {style.font-size: 24}
asignaciones -> actividades: "1:N" {style.font-size: 24}
